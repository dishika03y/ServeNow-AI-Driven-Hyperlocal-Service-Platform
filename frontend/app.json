{
  "expo": {
    "name": "ServeNow Worker",
    "slug": "servenow-worker",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#081F5C"
    },

    "platforms": ["ios", "android", "web"],

    "android": {
      "package": "com.servenow.worker",
      "permissions": ["CAMERA"],
      "jsEngine": "hermes"
    },

    "ios": {
      "jsEngine": "hermes"
    },

    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-router"]
  }
}